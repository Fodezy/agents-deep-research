{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research Report Plan",
  "description": "Schema for creating a comprehensive research plan with outline and background context",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1],
      "description": "Schema version for compatibility tracking"
    },
    "report_title": {
      "type": "string",
      "description": "A concise, descriptive title for the research report",
      "minLength": 10,
      "maxLength": 100
    },
    "background_context": {
      "type": "string",
      "description": "1-2 paragraphs of background context for the research",
      "minLength": 50,
      "maxLength": 1000
    },
    "report_outline": {
      "type": "array",
      "description": "List of sections that need to be written in the report",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the section",
            "minLength": 5,
            "maxLength": 80
          },
          "key_question": {
            "type": "string",
            "description": "The specific research question this section will answer",
            "minLength": 10,
            "maxLength": 200
          }
        },
        "required": ["title", "key_question"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "report_title", "background_context", "report_outline"],
  "additionalProperties": false
}